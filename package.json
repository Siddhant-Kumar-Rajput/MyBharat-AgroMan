{
  "name": "agroman",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions",
    "worker"
  ],
  "scripts": {
    "prepare:speech": "node scripts/copy-espeak.mjs",
    "predev": "npm run prepare:speech",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:speech",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
